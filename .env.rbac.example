#!/bin/bash
# .env.example - Environment configuration template for RBAC

# ============================================================================
# Keycloak Configuration
# ============================================================================
# URL of your Keycloak instance (without trailing slash)
VITE_URL_AUTH=https://keycloak.example.com

# Your Keycloak realm name
VITE_REALM=your-realm-name

# Client ID registered in Keycloak for this application
VITE_CLIENT_ID=enterprise-portal

# Enable/Disable Keycloak (default: true)
VITE_KEYCLOAK_ENABLED=true

# ============================================================================
# Role-Based Access Control (RBAC) Configuration
# ============================================================================

# Enforce role-based access control
# - true: Users without required roles will be logged out
# - false: No automatic role enforcement (but can still check roles in code)
VITE_KEYCLOAK_ENFORCE_ROLES=true

# Minimum required roles to access the application
# Users must have AT LEAST ONE of these roles
# Format: comma-separated values
# Example: admin,user,viewer
VITE_REQUIRED_ROLES=admin,user

# Module-to-Role mapping
# Defines which roles can access which modules
# Format: JSON object
# - Single role: "module": "role"
# - Multiple roles (ANY): "module": "role1,role2" or "module": ["role1", "role2"]
# 
# Available modules in the app:
#   - dashboard: Main dashboard
#   - ai-platform: AI Agent OS, Agents, Prompts, Skills, Teams, Workflows
#   - knowledge: Knowledge base search and management
#   - mcp: Model Context Protocol servers
#   - operations: Audit, Events, Logs, Monitoring
#   - system: Environment, Flags, Jobs, Settings

VITE_MODULE_ROLE_MAP={
  "dashboard": "user",
  "ai-platform": "admin",
  "knowledge": "user,editor",
  "mcp": "admin",
  "operations": "admin,auditor",
  "system": "system-admin"
}

# Alternative format (string-based):
# VITE_MODULE_ROLE_MAP={"dashboard":"user","ai-platform":"admin","knowledge":"user,editor","mcp":"admin","operations":"admin,auditor","system":"system-admin"}

# ============================================================================
# API Endpoints
# ============================================================================

# Agno Runtime API
VITE_AGNO_API_URL=/agno

# MCP Gateway API
VITE_MCP_API_URL=/mcp

# Knowledge Platform API
VITE_KNOWLEDGE_API_URL=/knowledge

# ============================================================================
# Example Configurations for Different Scenarios
# ============================================================================

# SCENARIO 1: Development (all users can access all modules)
# VITE_KEYCLOAK_ENFORCE_ROLES=false
# VITE_REQUIRED_ROLES=user
# VITE_MODULE_ROLE_MAP={}

# SCENARIO 2: Strict Access Control
# VITE_KEYCLOAK_ENFORCE_ROLES=true
# VITE_REQUIRED_ROLES=admin
# VITE_MODULE_ROLE_MAP={
#   "dashboard": "user",
#   "ai-platform": "admin",
#   "knowledge": "user,editor",
#   "mcp": "admin,system-admin",
#   "operations": "admin,auditor",
#   "system": "system-admin"
# }

# SCENARIO 3: Multi-tenant with different roles
# VITE_KEYCLOAK_ENFORCE_ROLES=true
# VITE_REQUIRED_ROLES=user
# VITE_MODULE_ROLE_MAP={
#   "dashboard": "user",
#   "ai-platform": "agent-admin",
#   "knowledge": "user,kb-manager",
#   "mcp": "mcp-admin",
#   "operations": "ops-admin",
#   "system": "sys-admin"
# }
